    }
}


# ============================================================
# CONSULTA DOS INDICADORES DISPONÍVEIS NO SGS
# ============================================================

resultados = []

for nome, info in indicadores.items():

    if info["codigo"] is not None:

        resultado = consultar_bcb(info["codigo"])

        if resultado:

            resultados.append({
                "Indicador": nome,
                "Valor": resultado["valor"],
                "Unidade": info["unidade"],
                "Data": resultado["data"],
                "Fonte": info["fonte"]
            })

        else:

            resultados.append({
                "Indicador": nome,
                "Valor": None,
                "Unidade": info["unidade"],
                "Data": None,
                "Fonte": info["fonte"]
            })

    else:

        resultados.append({
            "Indicador": nome,
            "Valor": None,
            "Unidade": info["unidade"],
            "Data": None,
            "Fonte": info["fonte"]
        })


