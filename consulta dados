# ------------------------------------------------------------
# FUNÇÃO PARA CONSULTAR O SGS DO BANCO CENTRAL
# ------------------------------------------------------------

def consultar_bcb(codigo, ultimos=1):

    url = (
        f"https://api.bcb.gov.br/dados/serie/"
        f"bcdata.sgs.{codigo}/dados/ultimos/{ultimos}"
        f"?formato=json"
    )

    try:
        resposta = requests.get(url, timeout=15)
        resposta.raise_for_status()

        dados = resposta.json()

        if not dados:
            return None

        ultimo = dados[-1]

        return {
            "data": ultimo["data"],
            "valor": float(ultimo["valor"].replace(",", "."))
        }

    except Exception as erro:
        print(f"Erro ao consultar série {codigo}: {erro}")
        return None


# ============================================================
# INDICADORES
# ============================================================

indicadores = {

    "Selic": {
        "fonte": "Banco Central",
        "codigo": 1178,
        "unidade": "%"
